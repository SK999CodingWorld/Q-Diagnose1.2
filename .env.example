# Q-Diagnose optional configuration.
#
# Copy to .env for local use. .env is gitignored and must never be committed.
# Every value below is OPTIONAL: with none of these set the app runs fully
# locally on the ideal simulator and refuses real hardware instead of faking it.

# IBM Quantum hardware access. Without a token, hardware-backed models are
# refused with HTTP 503 rather than silently downgraded to simulation.
# QISKIT_IBM_TOKEN=
# IBM_QUANTUM_TOKEN=

# Directory for user-uploaded datasets. Defaults to data/uploads.
# QDIAGNOSE_UPLOAD_DIR=data/uploads
